# NetContext Environment Configuration

# Neo4j Database Settings
NEO4J_USER=neo4j
NEO4J_PASSWORD=NetContextSecure2026!
NEO4J_URI=bolt://neo4j:7687
NEO4J_LOCAL_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Service Ports
INGESTION_PORT=8001
RAG_ENGINE_PORT=8002
UI_PORT=8501

# LLM / AI Configuration (for GraphRAG)
# You can provide either Gemini API Key or OpenAI API Key
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=gemini

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
